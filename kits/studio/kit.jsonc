{
  "$schema": "../../schemas/agentic-kit-v2.schema.json",
  "schema": "agentic-kit/v2",
  "id": "studio",
  "components": {
    "studio": "donors/Style_Gallery.docx",
    "running-header": "donors/Running_Header.docx",
    "folio-footer": "donors/Folio_Footer.docx"
  },
  "semantic_styles": {
    "heading_1": "Heading 1",
    "heading_2": "Heading 2",
    "heading_3": "Heading 3",
    "heading_4": "Heading 4",
    "heading_5": "Heading 5",
    "heading_6": "Heading 6",
    "body": "Normal",
    "bullet": "List Bullet",
    "numbered_step": "List Number",
    "command": "Studio Code",
    "note": "Studio Callout",
    "caption": "Caption"
  },
  "table_styles": {
    "technical": {
      "font_name": "Aptos",
      "font_size_pt": 8.8,
      "header_fill": "17324D",
      "header_text": "FFFFFF",
      "group_fill": "1E7A78",
      "group_text": "FFFFFF",
      "body_fill": "FFFFFF",
      "alternate_fill": "EDF4F3",
      "border_color": "B8C8CC",
      "text_color": "18242B",
      "cell_margin_twips": 96,
      "repeat_header": true,
      "allow_row_split": false
    },
    "compact": {
      "font_name": "Aptos",
      "font_size_pt": 8.0,
      "header_fill": "17324D",
      "header_text": "FFFFFF",
      "group_fill": "D8A84E",
      "group_text": "17324D",
      "body_fill": "FFFFFF",
      "alternate_fill": "F5F7F7",
      "border_color": "CAD4D6",
      "text_color": "18242B",
      "cell_margin_twips": 78,
      "repeat_header": true,
      "allow_row_split": false
    },
    "schedule": {
      "font_name": "Aptos",
      "font_size_pt": 9.0,
      "header_fill": "1E7A78",
      "header_text": "FFFFFF",
      "group_fill": "D8A84E",
      "group_text": "17324D",
      "body_fill": "FFFFFF",
      "alternate_fill": "EDF4F3",
      "border_color": "AFC5C3",
      "text_color": "18242B",
      "cell_margin_twips": 104,
      "repeat_header": true,
      "allow_row_split": false
    }
  }
}
